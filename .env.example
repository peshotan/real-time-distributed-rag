# Runtime mode
SOURCE=synthetic
EVENT_RATE=5
LIVE_RECONNECT_SECONDS=5
HN_POLL_SECONDS=5

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC=raw-events
KAFKA_GROUP_ID=rag-workers
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_POLL_TIMEOUT_MS=1000
KAFKA_BATCH_SIZE=32

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rag_chunks
QDRANT_VECTOR_SIZE=384
QDRANT_UPSERT_BATCH_SIZE=64

# Redis semantic cache
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=900
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_MAX_ENTRIES_SCANNED=500

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_ALLOW_HASHING_FALLBACK=true
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=35

# Gateway / LLM
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LLM_PROVIDER=mock
LLM_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.2
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=2.5
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=15